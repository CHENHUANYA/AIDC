# ── LLM Provider ─────────────────────────────────────────────
# LLM_PROVIDER=ollama                         # ollama | school
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=mistral-nemo:latest
# RAG_LLM_TIMEOUT_SECONDS=20

# ── School API (optional) ────────────────────────────────────
# SCHOOL_API_BASE_URL=
# SCHOOL_API_KEY=
# SCHOOL_API_MODEL=gpt-oss-120b
# SCHOOL_API_FALLBACK_TO_OLLAMA=true

# ── RAG / Embedding ─────────────────────────────────────────
# HF_HOME=./hf_cache
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# RAG_EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_HF_LOCAL_ONLY=auto

# ── Vector Store ─────────────────────────────────────────────
# VECTOR_STORE=chroma                         # chroma | qdrant
# DB_PATH=./alarm_db

# ── Qdrant (only if VECTOR_STORE=qdrant) ─────────────────────
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_VECTOR_SIZE=1024
# QDRANT_UPSERT_BATCH_SIZE=64

# ── Server ───────────────────────────────────────────────────
# ALARM_RAG_CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
