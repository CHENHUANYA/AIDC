# Alarm RAG runtime
ALARM_RAG_ENV=production
ALARM_RAG_BIND_ADDRESS=127.0.0.1
ALARM_RAG_PORT=8100
ALARM_RAG_CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
ALARM_RAG_LOG_LEVEL=INFO
ALARM_RAG_LOG_FORMAT=json
ALARM_RAG_SLOW_REQUEST_MS=1000
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=auto
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300
LOGIN_RATE_MAX_KEYS=10000
LOGIN_THROTTLE_RETENTION_SECONDS=300
LOGIN_THROTTLE_CLEANUP_BATCH_SIZE=1000
LOGIN_THROTTLE_CLEANUP_MAX_BATCHES=20
ADMIN_INITIAL_PASSWORD=change-me-now
ALARM_RAG_TRIGGER_TOKEN=replace-with-a-random-trigger-token
ALARM_RAG_INDEX_SIGNING_KEY=replace-with-a-long-random-index-signing-key
ALARM_RAG_INDEX_MAX_MB=128
ALARM_RAG_PDF_UPLOAD_MAX_MB=50
ALARM_RAG_EXCEL_UPLOAD_MAX_MB=10

# LLM provider
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral-nemo:latest
RAG_LLM_TIMEOUT_SECONDS=90
RAG_CHAT_TOP_K=3
RAG_CONTEXT_CHARS_PER_DOC=1800
RAG_MAX_OUTPUT_TOKENS=512
RAG_OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m

# Optional OpenAI-compatible provider
SCHOOL_API_BASE_URL=
SCHOOL_API_KEY=
SCHOOL_API_MODEL=gpt-oss-120b
SCHOOL_API_FALLBACK_TO_OLLAMA=true

# RAG and model cache
HF_HOME=./hf_cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
RAG_EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_HF_LOCAL_ONLY=true
RAG_PRELOAD_MODELS=0
# hybrid is the general-purpose default; title_bm25 is a low-latency alarm-description strategy.
RAG_RETRIEVAL_STRATEGY=hybrid

# Vector store
VECTOR_STORE=qdrant
DB_PATH=./alarm_db
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_CLIENT_TIMEOUT_SECONDS=5
QDRANT_HTTPS=false
# Authenticated HTTP is limited to these explicit loopback/container-network hosts.
# For cross-host Qdrant, set QDRANT_HTTPS=true. Only extend this list for a trusted private network.
QDRANT_INSECURE_TRUSTED_HOSTS=qdrant,localhost,127.0.0.1,::1
QDRANT_API_KEY=replace-with-a-long-random-qdrant-api-key
QDRANT_BIND_ADDRESS=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_VECTOR_SIZE=1024
QDRANT_UPSERT_BATCH_SIZE=64
QDRANT_TELEMETRY_DISABLED=true

# Maintenance
BACKUP_RETENTION_DAYS=14
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
N8N_DB_SQLITE_POOL_SIZE=2
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
